# Crate server configuration. Copy to server/.env and fill in the secrets.
#
# Suite rule: required NON-secret config (SUITE_JWKS_URL, SUITE_ISSUER, LM Studio pins, ntfy)
# is pinned in docker-compose.yml's `environment:` block — Compose does not re-read a changed
# env_file on recreate, and losing a flag that way has caused production regressions twice.
# This file is for secrets and local-dev values only.

# Postgres. Use 127.0.0.1, NOT localhost — Docker publishes IPv4-only and ::1-first
# resolution stalls every fresh connection (suite-wide gotcha). Host port 5436.
DATABASE_URL=postgresql+asyncpg://crate:crate@127.0.0.1:5436/crate

# Session-token signing key. Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME

# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# Suite SSO (SSO-only app — without these there is NO login path; in production they are
# pinned in compose `environment:`, set here only for local dev against the live identity server).
# SUITE_JWKS_URL=https://id.dragonflymedia.org/.well-known/jwks.json
# SUITE_ISSUER=https://id.dragonflymedia.org

# ── eBay (human-gated: developer account → sandbox keyset → production keyset) ──
# Keyset (App ID / Cert ID). Unset ⇒ pricing silently skipped, /comps + /ebay/connect 503.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# sandbox | production — the cutover is this one line (plus a production keyset + consent).
# EBAY_ENVIRONMENT=sandbox
# The RuName registered on the keyset; its accept URL must point at Crate's tailnet
# callback: https://<ts.net-host>:<port>/ebay/callback
# EBAY_RU_NAME=
# One-time seller setup (create in Seller Hub / sandbox): business policy ids + ship-from.
# Publishing 409s with a clear message until these exist.
# EBAY_FULFILLMENT_POLICY_ID=
# EBAY_PAYMENT_POLICY_ID=
# EBAY_RETURN_POLICY_ID=
# EBAY_LOCATION_POSTAL_CODE=

# Encrypts eBay OAuth tokens at rest (never stored plaintext). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FERNET_KEY=

# Deploy hardening (Crate is tailnet-only; leave TRUST_PROXY off unless a proxy fronts it).
# TRUST_PROXY=false
# HSTS_ENABLED=false
# DOCS_ENABLED=false
