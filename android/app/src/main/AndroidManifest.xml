<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Batch capture: in-app camera. Declaring CAMERA makes the runtime grant mandatory
         before launching capture — the screen requests it and falls back to the gallery
         picker on denial. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Read suite connection config from the Dragonfly hub. Granted only because all suite
         apps share one signing key; harmless if Dragonfly isn't installed. -->
    <uses-permission android:name="com.dragonfly.permission.READ_SUITE_CONFIG" />

    <!-- API 30+ package visibility: needed to resolve Dragonfly's ContentProvider. -->
    <queries>
        <package android:name="com.dragonfly" />
    </queries>

    <application
        android:name=".CrateApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Crate"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Crate">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AppAuth themes its AuthorizationManagementActivity as AppCompat but leaves
             RedirectUriReceiverActivity to inherit the app theme, which isn't AppCompat →
             it can crash on the redirect ("You need to use a Theme.AppCompat theme"). Force an
             AppCompat translucent theme on it (suite-wide manifest landmine — do not remove). -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:theme="@style/Theme.AppCompat.Translucent.NoTitleBar"
            tools:node="merge" />

        <!-- Hands the camera a cache-dir target for capture shots; queued photos are moved
             into filesDir/capture_queue/ so they survive until uploaded. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.crate.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Hilt worker factory: remove WorkManager's default initializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
